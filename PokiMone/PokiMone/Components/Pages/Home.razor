@page "/"
@using Microsoft.AspNetCore.Mvc
@using PokeApiNet
@using PokiMone.ExternalResources;
@using PokiMone.Services
@inject CacheService _cache

<PageTitle>PokiMone</PageTitle>

<h1 class="pokemon-page-title">There are 151 Pokemon</h1>

<table id="pokemonCards">
    <tr class="pokemonCardRow">
        @if (PokemonList?.Any() == true)
        {
            @foreach(var Pokemon in PokemonList)
            {
                <td class="pokemon-card">
                    <div class="card-header">
                        <span class="number">@Pokemon.Id</span>
                        <span class="card-title"><a href="@($"/detail/{Pokemon.Name}")">@Pokemon.Name</a></span>
                    </div>
                    <div class="card-image">
                        <img src="@($"images/{Pokemon.Name}.png")" alt="Bulbasaur">
                    </div>
                    <div class="card-details">
                        <div class="Stats">
                            <span class="total">@Pokemon.Stats.Sum(s => s.BaseStat)</span>
                        </div>
                        <div class="card-footer">
                            @foreach (var type in Pokemon.Types)
                            {
                                <span>@type.Type.Name</span>
                            }
                        </div>
                    </div>
                </td>
            }
        }
    </tr>
</table>

@code
{
    readonly PokeApiData apiLayer = new PokeApiData();
    List<Pokemon>? PokemonList = new List<Pokemon>();

    public int TotalPokemon = 151; //not sure why this is still here, might remove soon

    public async Task<List<Pokemon>> GetPokemonList()
    {
        var pokemonList = await apiLayer.GetPokemonRange();

        return pokemonList;
    }

    protected override async Task OnInitializedAsync()
    {
        PokemonList = await GetPokemonList();
    }
    protected override async void OnInitialized()
    {
        _ = _cache.EnsureMovesLoadedAsync();
    }
}