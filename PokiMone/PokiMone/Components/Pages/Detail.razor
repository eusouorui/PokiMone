@page "/detail/{pokemonName}"
@using PokeApiNet
@using PokiMone.ExternalResources;


<PageTitle>@pokemon.Name</PageTitle>

<h3></h3>

<div class="pokemon-card">
    <div class="pokemon-header">
        <h3>@(@pokemon.Name) - <span class="pokemon-id">#@pokemon.Id</span></h3>
    </div>

    <div class="pokemon-body">
        <img src="@($"images/{pokemon.Name}.png")" alt="@@pokemon.Name" class="pokemon-image" />

        <div class="pokemon-info">
            <p><strong>Height:</strong> @(pokemon.Height*10) cm</p> <!-- Their base unit is in decimeters so we convert to cm-->
            <p><strong>Weight:</strong> @((float)pokemon.Weight / 10) kg</p> <!-- Their base unit is in hectograms so we convert to kg-->
            <strong>Types:</strong><br><br>
            @foreach (var type in pokemon.Types)
            {
                <p><span class="@("type-badge "+type.Type.Name)">@(type.Type.Name)</span></p>
            }
            <div class="moves-section">
                Stats:<br>
                <ul class="move-list">
                    @foreach (var stat in pokemon.Stats)
                    {
                        <li>@(stat.Stat.Name) -> <span><strong>@(stat.BaseStat)</strong></span></li>
                    }
                </ul>
            </div>
            <div class="moves-section">
                <ul class="move-list">
                    Abilities:
                    @foreach (var ability in pokemon.Abilities)
                    {
                        <li>@(ability.Ability.Name)</li>
                    }
                </ul>
            </div>
            <div class="moves-section">
                Appears on:
                <ul class="move-list">
                    @foreach (var game in pokemon.GameIndicies)
                    {
                        <li>Pokemon @(game.Version.Name)</li>
                    }
                </ul>
            </div>
            <div class="moves-section">
                <button class="toggle-button" onclick="toggleView()"><strong>Moves:</strong></button>
                <table class="move-list" style="width:100%">
                    @{
                        int counter = 0;
                    }
                    @foreach (var move in moves)
                    {
                        if(counter > 5)
                        {
                            <tr hidden>
                                <td style="width:85%">@move.Name</td>
                                <td style="text-align:center" class="@("type-badge " + move.Type.Name)"> @move.Type.Name</td>
                            </tr>
                        }
                        else // Change this logic, I just left it like this cuz there's more important stuff to do rn...
                        {
                            <tr>
                                <td style="width:85%">@move.Name</td>
                                <td style="text-align:center" class="@("type-badge " + move.Type.Name)"> @move.Type.Name</td>
                            </tr>
                        }
                        counter++;
                    }
                </table>
            </div>
        </div>
    </div>
</div>

@code
{
    [Parameter]
    public string pokemonName { get; set; }
    public PokeApiData apiLayer = new PokeApiData();
    public Pokemon pokemon;
    public List<Move> moves = new();

    protected override async Task OnInitializedAsync()
    {
        pokemon = await apiLayer.GetPokemonDataAsync(pokemonName);
    
        if(pokemon != null)
            moves = await apiLayer.GetPokemonMoveTypes(pokemon);
    }
}

<style>
.pokemon-card {
    width: 500px;
    border: 1px solid #ccc;
    border-radius: 8px;
    padding: 1rem;
    background-color: #f9f9f9;
    box-shadow: 0 2px 5px rgba(0,0,0,0.1);
}
</style>
