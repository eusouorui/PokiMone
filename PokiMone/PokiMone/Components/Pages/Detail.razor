@page "/detail/{pokemonName}"
@using PokeApiNet
@using PokiMone.ExternalResources;



<PageTitle>@pokemon.Name</PageTitle>

<h3></h3>

<div class="pokemon-card">
    <div class="pokemon-header">
        <h3>@(@pokemon.Name) - <span class="pokemon-id">#@pokemon.Id</span></h3>
    </div>

    <div class="pokemon-body">
        <img src="@($"images/{pokemon.Name}.png")" alt="@@pokemon.Name" class="pokemon-image" />

        <div class="pokemon-info">
            <p><strong>Height:</strong> @(pokemon.Height*10) cm</p> <!-- Their base unit is in decimeters so we convert to cm-->
            <p><strong>Weight:</strong> @((float)pokemon.Weight / 10) kg</p> <!-- Their base unit is in hectograms so we convert to kg-->
            <strong>Types:</strong><br><br>
            @foreach (var type in pokemon.Types)
            {
                <p><span class="@("type-badge "+type.Type.Name)">@(type.Type.Name)</span></p>
            }
            <div class="moves-section">
                <ul class="move-list">
                    Stats:
                    @foreach (var stat in pokemon.Stats)
                    {
                        <li class="move-list">@(stat.Stat.Name) -> <span><strong>@(stat.BaseStat)</strong></span></li>
                    }
                </ul>
            </div>
            <div class="moves-section">
                <ul class="move-list">
                    Abilities:
                    @foreach (var ability in pokemon.Abilities)
                    {
                        <li class="move-list">@(ability.Ability.Name)</li>
                    }
                </ul>
            </div>
            <div class="moves-section">
                Appears on:
                @for (int i = 0; i < pokemon.GameIndicies.Count; i++)
                {
                    var game = pokemon.GameIndicies[i];
                    //<li class="move-list @hiddenClass">Pokemon @(game.Version.Name)</li>
                }
                <ul class="move-list">
                    @foreach (var game in pokemon.GameIndicies)
                    {
                        <li class="move-list">Pokemon @(game.Version.Name)</li>
                    }
                </ul>
            </div>
            <div class="moves-section">
                <ul class="move-list">
                    Moves:
                    @foreach (var type in pokemon.Moves)
                    {
                        <li class="move-list">@(type.Move.Name)</li>
                    }
                </ul>
            </div>
        </div>
    </div>
</div>

@code
{
    [Parameter]
    public string pokemonName { get; set; }
    public PokeApiData apiLayer = new PokeApiData();
    public Pokemon pokemon;

    protected override async Task OnInitializedAsync()
    {
        pokemon = await apiLayer.GetPokemonDataAsync(pokemonName);
    }
}

<style>
.pokemon-card {
    max-width: 400px;
    border: 1px solid #ccc;
    border-radius: 8px;
    padding: 1rem;
    background-color: #f9f9f9;
    box-shadow: 0 2px 5px rgba(0,0,0,0.1);
}
</style>